# server が使うツールの version pin（この repo が唯一の真実）。
# node/nvim/lazygit/lazydocker/delta/ghq/starship/herdr の version は mise が管理する
# （server/home/.config/mise/config.toml + mise.lock）。ここは mise 本体と、mise 管理外(npm)の pin だけ。
# ルール: 値はリテラルのみ。更新は PR で行い、clean な Ubuntu 24.04 で smoke test する。

# mise（版マネージャ）本体。raw バイナリを pin+sha で導入。
MISE_VERSION=2026.8.3
MISE_LINUX_X64_SHA256=66585ac496c10bf6fbf13272e3e550c1813aed0e1cb780b9bb73c1751de49289

# Dev Container CLI（npm。mise の node で --prefix ~/.local に導入）
DEVCONTAINER_CLI_VERSION=0.88.0

# nvim 設定（public repo）を commit 固定して再現可能にする（nvim 本体は mise 管理）
NVIM_USER_REPO=synpuls/nvim-user-v6
NVIM_USER_COMMIT=e50755fe52656d84b9df645d333703aaebb42a21
