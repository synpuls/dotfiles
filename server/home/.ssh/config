# server(Linux headless)用 ~/.ssh/config。mac 版から OrbStack Include を除いた形。
# Linux OpenSSH は UseKeychain 等の未知キーワードで config 全体が壊れるため、最初の Include/Host より
# 前で無視指定する(Include する ~/.ssh/config.local 側にも同指定あり。二重でも無害)。
IgnoreUnknown UseKeychain

# machine-local な追加設定は ~/.ssh/config.local(git 管理外・private bootstrap が供給)に置く。
# ※ Include は Host ブロックより前に置く。後ろに置くと直前の Host に従属してその Host 解決時しか読まれない。
Include ~/.ssh/config.local

Host github-synpuls
  HostName github.com
  IdentityFile ~/.ssh/github-synpuls.local
  User git
  IdentitiesOnly yes
  Compression yes
  AddKeysToAgent yes
  UseKeychain yes
