# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# machine-local な追加設定は ~/.ssh/config.local(git 管理外)に置く。
# ※ Include は Host ブロックより前に置く。後ろに置くと直前の Host に従属して
#    その Host 解決時しか読まれなくなる。
Include ~/.ssh/config.local

Host github-synpuls
  HostName github.com
  IdentityFile ~/.ssh/github-synpuls.local
  User git
  IdentitiesOnly yes
  Compression yes
  AddKeysToAgent yes
  UseKeychain yes
